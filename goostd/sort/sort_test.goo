// Tests for package sort.
//
// Every expected value was produced by running the same calls against Go's real
// sort package on go1.26.1, never hand-reasoned. The interesting ones are
// recorded beside their assertions.
//
// An internal test (package sort), so it also exercises the unexported siftDown
// through Sort and the unexported reverse type through Reverse.
package sort

import "testing"

func TestInts(t *testing.T) {
	// Go: [5 2 9 1 5 6] -> [1 2 5 5 6 9]. Duplicates included on purpose: a
	// comparison written <= instead of < can loop or mis-order on equal keys.
	x := []int{5, 2, 9, 1, 5, 6}
	Ints(x)
	want := []int{1, 2, 5, 5, 6, 9}
	for i := 0; i < len(want); i++ {
		if x[i] != want[i] {
			t.Errorf("Ints[%d] = %d, want %d", i, x[i], want[i])
		}
	}
}

func TestIntsEmptyAndSingle(t *testing.T) {
	// n < 2 takes the early return in Sort. Go treats both as sorted.
	empty := []int{}
	Ints(empty)
	if len(empty) != 0 {
		t.Errorf("empty len = %d, want 0", len(empty))
	}
	if !IntsAreSorted(empty) {
		t.Errorf("IntsAreSorted(empty) = false, want true")
	}
	one := []int{42}
	Ints(one)
	if one[0] != 42 {
		t.Errorf("single = %d, want 42", one[0])
	}
}

func TestIntsAlreadySortedAndReversed(t *testing.T) {
	asc := []int{1, 2, 3, 4, 5}
	Ints(asc)
	if !IntsAreSorted(asc) {
		t.Errorf("already-sorted input came back unsorted")
	}
	desc := []int{5, 4, 3, 2, 1}
	Ints(desc)
	if desc[0] != 1 || desc[4] != 5 {
		t.Errorf("reversed input = %d..%d, want 1..5", desc[0], desc[4])
	}
}

func TestStrings(t *testing.T) {
	// Go: [pear apple fig] -> [apple fig pear].
	s := []string{"pear", "apple", "fig"}
	Strings(s)
	if s[0] != "apple" {
		t.Errorf("Strings[0] = %s, want apple", s[0])
	}
	if s[1] != "fig" {
		t.Errorf("Strings[1] = %s, want fig", s[1])
	}
	if s[2] != "pear" {
		t.Errorf("Strings[2] = %s, want pear", s[2])
	}
	if !StringsAreSorted(s) {
		t.Errorf("StringsAreSorted = false after Strings")
	}
}

func TestFloat64s(t *testing.T) {
	// Go: [2.5 -1 3.25] -> [-1 2.5 3.25].
	f := []float64{2.5, -1.0, 3.25}
	Float64s(f)
	if f[0] != -1.0 {
		t.Errorf("Float64s[0] = %f, want -1", f[0])
	}
	if f[2] != 3.25 {
		t.Errorf("Float64s[2] = %f, want 3.25", f[2])
	}
	if !Float64sAreSorted(f) {
		t.Errorf("Float64sAreSorted = false after Float64s")
	}
}

func TestIsSortedOnInterface(t *testing.T) {
	// IsSorted taken DIRECTLY, not through the IntsAreSorted wrapper, because
	// it is public API in its own right — a caller with a custom Interface has
	// no wrapper to go through.
	var sorted IntSlice = []int{1, 2, 3}
	if !IsSorted(sorted) {
		t.Errorf("IsSorted([1 2 3]) = false, want true")
	}
	var unsorted IntSlice = []int{3, 1, 2}
	if IsSorted(unsorted) {
		t.Errorf("IsSorted([3 1 2]) = true, want false")
	}
	// Reverse-wrapped: descending data IS sorted under the inverted Less.
	var desc IntSlice = []int{3, 2, 1}
	if !IsSorted(Reverse(desc)) {
		t.Errorf("IsSorted(Reverse([3 2 1])) = false, want true")
	}
}

func TestIsSortedDetectsUnsorted(t *testing.T) {
	// The negative direction. Without this, an IsSorted that always returned
	// true would satisfy every other assertion in this file.
	if IntsAreSorted([]int{2, 1}) {
		t.Errorf("IntsAreSorted([2 1]) = true, want false")
	}
	if StringsAreSorted([]string{"b", "a"}) {
		t.Errorf("StringsAreSorted([b a]) = true, want false")
	}
	if Float64sAreSorted([]float64{2.0, 1.0}) {
		t.Errorf("Float64sAreSorted([2 1]) = true, want false")
	}
}

func TestReverse(t *testing.T) {
	// Go: sort.Sort(sort.Reverse(sort.IntSlice(r))) on [1 2 3] -> [3 2 1].
	r := []int{1, 2, 3}
	var s IntSlice = r
	Sort(Reverse(s))
	if r[0] != 3 || r[1] != 2 || r[2] != 1 {
		t.Errorf("Reverse = %d %d %d, want 3 2 1", r[0], r[1], r[2])
	}
}

func TestSearchInts(t *testing.T) {
	// Go, on [1 2 5 5 6 9]: 5 -> 2 (FIRST of the duplicates), 7 -> 5, 0 -> 0.
	a := []int{1, 2, 5, 5, 6, 9}
	got := SearchInts(a, 5)
	if got != 2 {
		t.Errorf("SearchInts(a, 5) = %d, want 2", got)
	}
	mid := SearchInts(a, 7)
	if mid != 5 {
		t.Errorf("SearchInts(a, 7) = %d, want 5", mid)
	}
	low := SearchInts(a, 0)
	if low != 0 {
		t.Errorf("SearchInts(a, 0) = %d, want 0", low)
	}
	// Past the end: every element is smaller, so the answer is len(a).
	high := SearchInts(a, 100)
	if high != len(a) {
		t.Errorf("SearchInts(a, 100) = %d, want %d", high, len(a))
	}
}

func TestIntsLarge(t *testing.T) {
	// Twenty elements with negatives and duplicates. The small cases above all
	// fit in a heap two or three levels deep, where several sift-down bugs
	// cannot show themselves — this one exercises the loop properly.
	//
	// The expected order is Go's output for this exact input.
	x := []int{37, -5, 12, 0, 99, -5, 41, 8, 23, 7, 64, 3, 88, 15, -20, 56, 2, 71, 33, 19}
	want := []int{-20, -5, -5, 0, 2, 3, 7, 8, 12, 15, 19, 23, 33, 37, 41, 56, 64, 71, 88, 99}
	Ints(x)
	if len(x) != len(want) {
		t.Fatalf("len = %d, want %d", len(x), len(want))
	}
	for i := 0; i < len(want); i++ {
		if x[i] != want[i] {
			t.Errorf("Ints[%d] = %d, want %d", i, x[i], want[i])
		}
	}
}

func TestSortUsesUserInterface(t *testing.T) {
	// Sort must drive a caller's own Len/Less/Swap, not just the built-in
	// slice types — that is the entire reason Interface exists.
	var s IntSlice = []int{3, 1, 2}
	Sort(s)
	if s[0] != 1 || s[2] != 3 {
		t.Errorf("Sort(IntSlice) = %d..%d, want 1..3", s[0], s[2])
	}
}
