package main

import "fmt"

// Wave 1 Task 6: `=` and `:=` with any number of names. Every shape below
// was a parse error at the second comma before the list productions. The
// expected output comes from `go run` of the same source.

type pair struct {
	a int
	b string
}

type shape interface {
	area() int
}

type sq struct{ n int }

func (s sq) area() int { return s.n * s.n }

func f3() (int, bool, string) {
	return 7, true, "seven"
}

func f4() (int, int, int, int) {
	return 1, 2, 3, 4
}

func main() {
	// Three names, three values.
	a, b, c := 1, 2, 3
	fmt.Println(a, b, c)

	// Rotation: every value is read before any store.
	a, b, c = c, a, b
	fmt.Println(a, b, c)

	// Three names from one call.
	x, ok, s := f3()
	fmt.Println(x, ok, s)

	// Blanks in a destructure.
	_, _, z := f3()
	fmt.Println(z)

	// Assignment from one call to existing names.
	var p int
	var q bool
	var r string
	p, q, r = f3()
	fmt.Println(p, q, r)

	// Four names from one call, with a blank in the middle.
	w1, _, w3, w4 := f4()
	fmt.Println(w1, w3, w4)

	// The index operand is evaluated before the store to i.
	i := 0
	xs := []int{0, 0}
	i, xs[i] = 1, 100
	fmt.Println(i, xs[0], xs[1])

	// The same with the index target first.
	j := 0
	ys := []int{0, 0}
	ys[j], j = 50, 1
	fmt.Println(j, ys[0], ys[1])

	// Redeclaration: b2 exists, so only c2 is new.
	a2, b2 := 1, 2
	b2, c2 := 3, 4
	fmt.Println(a2, b2, c2)

	// Repeated target: the last store wins.
	t := 0
	t, t, t = 1, 2, 3
	fmt.Println(t)

	// Three names in a for clause.
	w := 0
	for k, m, n := 0, 0, 0; m < 3; m, n = m+1, n+2 {
		w += n
		k++
		_ = k
	}
	fmt.Println(w)

	// Mixed lvalues: field, index, pointer, identifier.
	var pr pair
	arr := []string{"", ""}
	v := 0
	pv := &v
	pr.a, arr[1], *pv, pr.b = 5, "x", 9, "y"
	fmt.Println(pr.a, pr.b, arr[1], v)

	// Narrow integer targets coerce each value.
	var n8 int8
	var n16 int16
	var n32 int32
	n8, n16, n32 = 100, 30000, 2000000000
	fmt.Println(n8, n16, n32)

	// Interface targets box each concrete value.
	var s1, s2, s3 shape
	s1, s2, s3 = sq{1}, sq{2}, sq{3}
	fmt.Println(s1.area(), s2.area(), s3.area())

	// Strings: three rebinds of string values.
	u1, u2, u3 := "a", "b", "c"
	u1, u2, u3 = u3+"!", u1+"?", u2+"."
	fmt.Println(u1, u2, u3)

	// if-init and switch-init with three names.
	if e1, e2, e3 := 1, 2, 3; e1+e2 == e3 {
		fmt.Println("if-init", e1, e2, e3)
	}
	switch g1, g2, g3 := "x", "y", "z"; g1 + g2 + g3 {
	case "xyz":
		fmt.Println("switch-init", g1, g2, g3)
	}

	// The two-name forms still work.
	h1, h2 := 10, 20
	h1, h2 = h2, h1
	fmt.Println(h1, h2)
}
