// far_world_probe: the far_jacobi_probe convergence loop, but the world
// size is an ARGUMENT, so one fixture covers world 1, 2, 4 and 8 with the
// SAME global problem. n=32 cells, 2 lanes per rank (Partition's lane
// count is comptime, so it is fixed at 2): a rank owns n/world cells. Every
// rank recomputes the serial reference locally and pins: (1) its span of
// the final field bit-for-bit, (2) each of its lanes' round count against
// the reference count.
//
// Call: <bin> near            in-process, no transport
//       <bin> far <rank> <urlBase> <world> [fault rank]
//
// `fault` exists ONLY for scripts/far_world_probe.sh --self-test, which
// must prove the gate can go red. Nothing in the normal gate passes it.
//   value  : `rank` corrupts one cell of its final span
//   rounds : `rank` miscounts its lane-0 rounds
//   world  : `rank` passes world-1 to RunFar, so the ranks disagree
package main

import "fmt"
import "lanes"
import "os"
import "strconv"

func main() {
	args := os.Args
	n := 32
	coeffs := []float64{0.25, 0.5, 0.25}
	tol := 0.05
	maxRounds := 4000

	// Non-uniform global field, so every rank holds non-trivial data.
	g := make([]float64, n)
	for i := 0; i < n; i++ {
		g[i] = float64((i * 7) % 11)
	}

	// Serial reference: one Jacobi step over the whole field per round,
	// stop when the global max-norm delta falls under tol.
	r := make([]float64, n)
	prev := make([]float64, n)
	for i := 0; i < n; i++ {
		r[i] = g[i]
	}
	refRounds := 0
	for round := 0; round < maxRounds; round++ {
		for i := 0; i < n; i++ {
			prev[i] = r[i]
		}
		delta := 0.0
		for i := 0; i < n; i++ {
			left := 0.0
			if i > 0 {
				left = prev[i-1]
			}
			right := 0.0
			if i < n-1 {
				right = prev[i+1]
			}
			acc := 0.25 * left
			acc = acc + 0.5*prev[i]
			acc = acc + 0.25*right
			r[i] = acc
			d := acc - prev[i]
			if d < 0.0 {
				d = 0.0 - d
			}
			if d > delta {
				delta = d
			}
		}
		refRounds = refRounds + 1
		if delta < tol {
			break
		}
	}

	if args[1] == "near" {
		whole := make([]float64, n)
		for i := 0; i < n; i++ {
			whole[i] = g[i]
		}
		nearRounds := []float64{0.0, 0.0}
		np := lanes.Partition(whole, 2)
		nres := lanes.Run(np, maxRounds, func(ctx *lanes.Lane) {
			own := ctx.Own()
			mine := 0.0
			before := make([]float64, len(own))
			for {
				for i := 0; i < len(own); i++ {
					before[i] = own[i]
				}
				lanes.StencilStep(ctx, 1, coeffs)
				local := 0.0
				for i := 0; i < len(own); i++ {
					d := own[i] - before[i]
					if d < 0.0 {
						d = 0.0 - d
					}
					if d > local {
						local = d
					}
				}
				delta := ctx.AllReduceMax(local)
				mine = mine + 1.0
				if delta < tol {
					break
				}
				if !ctx.Step() {
					break
				}
			}
			nearRounds[ctx.ID()] = mine
		})
		nearOK := true
		for i := 0; i < n; i++ {
			if nres[i] != r[i] {
				nearOK = false
			}
		}
		fmt.Println(nearOK)
		fmt.Println(nearRounds[0] == float64(refRounds))
		fmt.Println(nearRounds[1] == float64(refRounds))
		return
	}

	rank := strconv.Atoi(args[2]) catch e {
		panic(e.Error())
	}
	urlBase := args[3]
	world := strconv.Atoi(args[4]) catch e {
		panic(e.Error())
	}
	fault := ""
	faultRank := -1
	if len(args) > 6 {
		fault = args[5]
		faultRank = strconv.Atoi(args[6]) catch e {
			panic(e.Error())
		}
	}
	if n%(world*2) != 0 {
		panic("far_world_probe: world must divide n/2")
	}
	span := n / world

	runWorld := world
	if fault == "world" && rank == faultRank {
		runWorld = world - 1
	}

	a := make([]float64, span)
	for i := 0; i < span; i++ {
		a[i] = g[rank*span+i]
	}
	rounds := []float64{0.0, 0.0}
	p := lanes.Partition(a, 2)
	res := lanes.RunFar(p, maxRounds, rank, runWorld, urlBase, func(ctx *lanes.Lane) {
		own := ctx.Own()
		mine := 0.0
		before := make([]float64, len(own))
		for {
			for i := 0; i < len(own); i++ {
				before[i] = own[i]
			}
			lanes.StencilStep(ctx, 1, coeffs)
			local := 0.0
			for i := 0; i < len(own); i++ {
				d := own[i] - before[i]
				if d < 0.0 {
					d = 0.0 - d
				}
				if d > local {
					local = d
				}
			}
			delta := ctx.AllReduceMax(local)
			mine = mine + 1.0
			if delta < tol {
				break
			}
			if !ctx.Step() {
				break
			}
		}
		rounds[ctx.ID()] = mine
	})

	if fault == "value" && rank == faultRank {
		res[0] = res[0] + 1.0e-9
	}
	if fault == "rounds" && rank == faultRank {
		rounds[0] = rounds[0] + 1.0
	}

	base := rank * span
	valsOK := true
	for i := 0; i < span; i++ {
		if res[i] != r[base+i] {
			valsOK = false
		}
	}
	fmt.Println(valsOK)
	fmt.Println(rounds[0] == float64(refRounds))
	fmt.Println(rounds[1] == float64(refRounds))
	fmt.Println(refRounds > 1)
}
