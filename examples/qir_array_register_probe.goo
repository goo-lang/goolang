// Phase 7 M4 + Phase 8 M1 Probe:
// 1. Fixed-size linear qubit register `var q [3]qir.Qubit` with per-slot
//    compile-time ownership tracking (`q[0]`, `q[1]`, `q[2]`).
// 2. Deterministic FPGA hardware-control filter `fpga_syndrome_Accum` verified
//    by Goo's FPGA synthesis subset checker (`fpga_*` / `--check-fpga`).
package main

import "fmt"
import "qir"

func fpga_syndrome_accum(history [4]int, latest int) int {
	acc := latest
	i := 0
	for i < 4 {
		acc = acc + history[i]
		i = i + 1
	}
	return acc
}

func main() {
	var q [3]qir.Qubit
	q[0] = qir.Alloc()
	q[1] = qir.Alloc()
	q[2] = qir.Alloc()

	// Prepare 3-qubit GHZ state |000> + |111> across the linear array register
	qir.H(q[0])
	qir.CX(q[0], q[1])
	qir.CX(q[1], q[2])

	// Uncompute back to |000> so all three slots can be freed cleanly
	qir.CX(q[1], q[2])
	qir.CX(q[0], q[1])
	qir.H(q[0])

	r0 := qir.MeasureReset(q[0])
	r1 := qir.MeasureReset(q[1])
	r2 := qir.MeasureReset(q[2])

	b0 := 0
	if r0 {
		b0 = 1
	}
	b1 := 0
	if r1 {
		b1 = 1
	}
	b2 := 0
	if r2 {
		b2 = 1
	}

	hist := [4]int{1, 1, 1, 1}
	score := fpga_syndrome_accum(hist, b0+b1+b2)
	fmt.Println("array_ghz_uncomputed", b0, b1, b2, "fpga_score", score)
}
