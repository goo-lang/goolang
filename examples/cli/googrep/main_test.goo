// Tests for googrep's pure matching logic.
//
// This file could not run when it was written: the synthesized _testmain.goo
// declared a `main` that collided with the tool's own, and a CLI tool IS
// package main, so no CLI tool could have tests at all (GAP 3 in
// docs/superpowers/specs/2026-07-27-cli-readiness-findings.md).
//
// It was committed anyway, as the regression pin for the moment that gap
// closed. It now runs: `goo test .` in this directory passes.
package main

import "testing"

func TestMatchLinesBasic(t *testing.T) {
	text := "alpha one\nbeta two\nalpha three\n"
	lines, count := matchLines(text, "alpha", false, "f", false)
	if count != 2 {
		t.Errorf("count = %d, want 2", count)
	}
	if len(lines) != 2 {
		t.Fatalf("len(lines) = %d, want 2", len(lines))
	}
	if lines[0] != "alpha one" {
		t.Errorf("lines[0] = %s, want alpha one", lines[0])
	}
}

func TestMatchLinesNoMatch(t *testing.T) {
	lines, count := matchLines("a\nb\n", "zzz", false, "f", false)
	if count != 0 {
		t.Errorf("count = %d, want 0", count)
	}
	if len(lines) != 0 {
		t.Errorf("len(lines) = %d, want 0", len(lines))
	}
}

func TestMatchLinesLineNumbers(t *testing.T) {
	text := "no\nyes\n"
	lines, _ := matchLines(text, "yes", true, "f", false)
	if lines[0] != "2:yes" {
		t.Errorf("lines[0] = %s, want 2:yes", lines[0])
	}
}

func TestMatchLinesWithName(t *testing.T) {
	lines, _ := matchLines("yes\n", "yes", false, "a.txt", true)
	if lines[0] != "a.txt:yes" {
		t.Errorf("lines[0] = %s, want a.txt:yes", lines[0])
	}
}

func TestMatchLinesTrailingNewline(t *testing.T) {
	// A trailing newline must not produce a phantom final empty line.
	_, count := matchLines("x\n", "", false, "f", false)
	if count != 1 {
		t.Errorf("count = %d, want 1 (empty pattern matches the one real line)", count)
	}
}
