package main

import (
	"container/ring"
	"fmt"
)

func dump(r *ring.Ring) {
	r.Do(func(p any) {
		fmt.Print(p, " ")
	})
	fmt.Println("| len", r.Len())
}

func main() {
	r := ring.New(4)
	n := r.Len()
	for i := 0; i < n; i++ {
		r.Value = i
		r = r.Next()
	}
	dump(r)
	fmt.Println(r.Prev().Value, r.Move(2).Value, r.Move(-1).Value)
	s := ring.New(2)
	s.Value = 10
	sn := s.Next()
	sn.Value = 11
	r.Link(s)
	dump(r)
	u := r.Unlink(2)
	dump(r)
	dump(u)
}
