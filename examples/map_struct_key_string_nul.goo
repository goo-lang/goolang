package main

import "fmt"

type K struct {
	s string
	n int
}

func main() {
	m := map[K]int{}
	m[K{"x\x00y", 1}] = 10
	m[K{"x\x00z", 1}] = 20
	fmt.Println(len(m), m[K{"x\x00y", 1}], m[K{"x\x00z", 1}])
	t := "hello world"
	m2 := map[K]int{}
	m2[K{t[0:5], 1}] = 3
	m2[K{t, 1}] = 4
	fmt.Println(len(m2), m2[K{"hello", 1}], m2[K{"hello world", 1}])
}
