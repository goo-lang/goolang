// T4 slice release, the POSITIVE case: a slice local's data buffer is reclaimed.
//
// A slice is a FAT VALUE -- `{ T*, i64, i64 }`, held inline. The heap object is
// field 0, the data buffer, so the release targets the field and not the slot.
// That is why the pointer-only emission in PR #261 reclaimed 0% on the daemon
// even though the plan approved `fields`.
//
// TWO SHAPES, because they allocate through different paths:
//   `lit`      a slice literal with elements, allocated at the literal site
//   `fromCall` a slice returned by a Goo function whose return_escapes is false,
//              so condition 2 reads the result as owned
//
// Both buffers carry an ARC header: a literal goes through goo_alloc, and
// goo_slice_append uses goo_realloc, which moves the BASE and keeps the header
// (src/runtime/runtime.c).
//
// NOT USED HERE: `append` on the local. `xs = append(xs, n)` marks `xs` escaping,
// because append has no param_escape summary and an unresolved callee is
// conservative. So an appended slice is refused today, and that is why the daemon
// gains only `fields` (from strings.Split) and not `parts`.
//
// IMPORT-FREE, for the reason the other arc probes record.
package main

var sink int

func lit(n int) {
	xs := []int{1, 2, 3}
	sink = sink + len(xs) + n
}

func mk(n int) []int {
	return []int{4, 5, 6, 7}
}

func fromCall(n int) {
	ys := mk(n)
	sink = sink + len(ys)
}

func main() {
	for i := 0; i < 10000; i++ {
		lit(i)
		fromCall(i)
	}
}
