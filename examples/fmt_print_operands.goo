package main

import "fmt"

type S struct{ N int }

func (s S) String() string { return fmt.Sprintf("S%d", s.N) }

type T struct{ N int }

func main() {
	fmt.Print(S{1}, S{2}, "\n")
	fmt.Print(S{1}, T{2}, S{3}, "\n")
	fmt.Print(1, 2, "\n")
	fmt.Print("a", 1, 2, "b", "c", 3.5, S{4}, "\n")
	fmt.Print(S{1}, 2, S{3}, 4, "\n")
	fmt.Print(T{1}, T{2}, "\n")
	fmt.Println(fmt.Sprint(S{1}, S{2}, "x", S{3}, T{4}, 5, 6))
	fmt.Println(fmt.Sprint("a", "b", S{1}))
	fmt.Println(fmt.Sprint(S{1}, "a", "b"))
	fmt.Println(fmt.Sprint(2.5, S{1}, 3))
	fmt.Println(fmt.Sprintln(S{1}, T{2}, 3, "z"))
}
