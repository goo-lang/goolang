// method_variadic_probe: a METHOD with a `...T` parameter failed LLVM module
// verification for every argument count. The method-call argument loop in
// call_codegen.c was purely 1:1 positional — margc was 1 + the AST argument
// count — with no variadic concept at all, so the trailing actuals were
// passed as separate arguments instead of being packed into one slice:
//
//   Incorrect number of arguments passed to called function!
//     call void @Acc__AddAll(ptr %a, i64 1, i64 2, i64 3)
//
// The checker was already correct (it knows the method is variadic and
// rejects a wrong element type), so this was codegen-only.
//
// `a.AddAll(s...)` is the one shape that already worked, by accident: with
// spread there is exactly ONE trailing actual, so positional mapping happened
// to land the slice in the right slot. The two spread lines below are
// therefore regression pins, not new behaviour.
//
// Expected output produced by `go run` on the equivalent Go program (go1.26.1),
// per the project convention that accept goldens are never hand-written.
package main

import "fmt"

type Acc struct {
	total int
	tag   int
}

// Pointer receiver, purely variadic.
func (a *Acc) AddAll(ns ...int) {
	for _, n := range ns {
		a.total = a.total + n
	}
}

// Value receiver, purely variadic.
func (a Acc) SumWith(ns ...int) int {
	s := a.total
	for _, n := range ns {
		s = s + n
	}
	return s
}

// A FIXED parameter ahead of the variadic one — this is what pins the
// fixed/variadic split, since the packed slice must land after the fixed
// args rather than at a position derived from the actual arg count.
func (a *Acc) AddScaled(k int, ns ...int) {
	for _, n := range ns {
		a.total = a.total + k*n
	}
}

func plainAll(ns ...int) int {
	s := 0
	for _, n := range ns {
		s = s + n
	}
	return s
}

func main() {
	a := Acc{}

	// Control: the plain-call path already packed correctly.
	fmt.Println("plain many:", plainAll(1, 2, 3))
	fmt.Println("plain zero:", plainAll())

	// Zero trailing args must still pass an (empty) slice.
	a.AddAll()
	fmt.Println("ptr recv zero:", a.total)

	// One trailing arg must be PACKED, not passed positionally.
	a.AddAll(5)
	fmt.Println("ptr recv one:", a.total)

	// Many trailing args.
	a.AddAll(1, 2, 3)
	fmt.Println("ptr recv many:", a.total)

	// Value receiver, same three shapes.
	fmt.Println("val recv zero:", a.SumWith())
	fmt.Println("val recv many:", a.SumWith(10, 20))

	// Fixed parameter ahead of the variadic one.
	b := Acc{}
	b.AddScaled(3, 1, 2)
	fmt.Println("fixed+variadic:", b.total)
	b.AddScaled(10)
	fmt.Println("fixed, zero variadic:", b.total)

	// A struct FIELD as a trailing arg, exercising the lvalue load.
	a.tag = 7
	c := Acc{}
	c.AddAll(a.tag, a.tag)
	fmt.Println("field args:", c.total)

	// Spread. This already worked before the fix (one trailing arg happens
	// to land in the right slot), so it is a regression pin, not new
	// behaviour.
	s := []int{1, 2, 3}
	d := Acc{}
	d.AddAll(s...)
	fmt.Println("spread:", d.total)

	// Spread of an EMPTY slice.
	e := Acc{}
	var empty []int
	e.AddAll(empty...)
	fmt.Println("spread empty:", e.total)
}
