package main

import "fmt"

type Base struct{ ID int }

func (b *Base) String() string { return fmt.Sprintf("Base#%d", b.ID) }

type Derived struct {
	*Base
	Name string
}

type ValBase struct{ ID int }

func (b ValBase) String() string { return fmt.Sprintf("ValBase#%d", b.ID) }

type ValDerived struct {
	ValBase
	Name string
}

type PtrOnly struct{ ID int }

func (p *PtrOnly) String() string { return "PtrOnly" }

type Holder struct {
	PtrOnly
}

func main() {
	d := Derived{&Base{1}, "d"}
	fmt.Println(d)
	fmt.Println(&d)
	fmt.Printf("%v %s\n", d, d)
	v := ValDerived{ValBase{2}, "v"}
	fmt.Println(v)
	fmt.Println(&v)
	h := Holder{PtrOnly{3}}
	fmt.Println(h)
	fmt.Println(&h)
	fmt.Println(fmt.Sprint(h, &h))
}
