package main

import "fmt"
import "qir"

func main() {
	q0 := qir.Alloc()
	q1 := qir.Alloc()
	q2 := qir.Alloc()
	q3 := qir.Alloc()
	q4 := qir.Alloc()
	q5 := qir.Alloc()
	q6 := qir.Alloc()
	q7 := qir.Alloc()
	q8 := qir.Alloc()
	q9 := qir.Alloc()
	q10 := qir.Alloc()
	q11 := qir.Alloc()
	q12 := qir.Alloc()
	q13 := qir.Alloc()
	q14 := qir.Alloc()
	q15 := qir.Alloc()
	fmt.Println("allocating the 17th qubit")
	q16 := qir.Alloc()
	qir.X(q16)
	r := qir.ResultAt(0)
	qir.Mz(q0, r)
	fmt.Println("unreachable:", qir.ReadResult(r))
	qir.MeasureReset(q0)
	qir.MeasureReset(q1)
	qir.MeasureReset(q2)
	qir.MeasureReset(q3)
	qir.MeasureReset(q4)
	qir.MeasureReset(q5)
	qir.MeasureReset(q6)
	qir.MeasureReset(q7)
	qir.MeasureReset(q8)
	qir.MeasureReset(q9)
	qir.MeasureReset(q10)
	qir.MeasureReset(q11)
	qir.MeasureReset(q12)
	qir.MeasureReset(q13)
	qir.MeasureReset(q14)
	qir.MeasureReset(q15)
	qir.MeasureReset(q16)
}
