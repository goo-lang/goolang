// The loop-scoped release, and the store that must stop it.
//
// Condition 6 (include/release_decision.h) relaxed condition 4's loop half, so
// a local declared inside a loop is now released at ITERATION end. This probe
// exists because the measurement that motivated that change
// (docs/adr/0002-measurements/loop_carried_store_findings.md) recorded that the
// HAZARD and the CONTROL were INDISTINGUISHABLE under the old rule: both read
// RELEASE_NO_LOOP_SCOPE. A relaxation that frees live memory and a correct one
// looked the same.
//
// TWO HALVES, and the gate needs both:
//
//   carried()    the HAZARD. `keep` is declared outside the loop and still
//                points at the buffer after the producing iteration ends.
//                Releasing `s` there leaves it dangling, and the read below is
//                a read of freed memory. Condition 6 must refuse `s`.
//
//   the rest     the SIX EXIT PATHS a loop iteration can end on. Each declares
//                a loop-scoped string nothing retains, so each must reclaim.
//                Without them the hazard half alone would pass on a compiler
//                that simply released nothing.
//
// EVERY READ IS OF THE BYTES, never only the length. A string is a fat value:
// `len(x)` reads the length field and touches no heap memory, so a probe built
// on len() stays green over a freed buffer. ToUpper and comparison read the
// bytes, which is what makes valgrind see the defect.
package main

import (
	"fmt"
	"strings"
)

// THE HAZARD. Must print the last request in upper case, valgrind-clean.
func carried(reqs []string) string {
	keep := ""
	for i := 0; i < len(reqs); i++ {
		s := strings.TrimSpace(reqs[i])
		keep = s
	}
	return strings.ToUpper(keep)
}

// EXIT PATH 1 — fall-through, the end of the body. Nearly all reclamation
// happens here; the others are the exceptions.
func fallThrough(n int) int {
	hits := 0
	for i := 0; i < n; i++ {
		s := strings.TrimSpace("  aaaaaaaaaaaaaaaaaaaa  ")
		if len(s) == 20 {
			hits = hits + 1
		}
	}
	return hits
}

// EXIT PATH 2 — `continue`, which leaves the iteration before its end.
func withContinue(n int) int {
	hits := 0
	for i := 0; i < n; i++ {
		s := strings.TrimSpace("  bbbbbbbbbbbbbbbbbbbb  ")
		if len(s) == 20 {
			hits = hits + 1
			continue
		}
		hits = hits + 1000
	}
	return hits
}

// EXIT PATH 3 — `break`, which leaves the loop entirely.
func withBreak(n int) int {
	hits := 0
	for i := 0; i < n; i++ {
		s := strings.TrimSpace("  cccccccccccccccccccc  ")
		if len(s) == 20 {
			hits = hits + 1
		}
		if i > 2 {
			break
		}
	}
	return hits
}

// EXIT PATH 4 — `return` out of the loop body. This one does NOT go through the
// iteration-end path: it goes through the function-exit wrapper, which runs the
// defers first and then releases every site, loop-scoped ones included. The
// slot still holds the live value at that instant, so it is the right free.
func withReturn(n int) int {
	for i := 0; i < n; i++ {
		s := strings.TrimSpace("  dddddddddddddddddddd  ")
		if len(s) == 20 {
			return i + 1
		}
	}
	return 0
}

// EXIT PATH 5 — a LABELLED continue, crossing two loop levels at once. Both the
// inner and the outer iteration end here, so both loops' locals must go.
func withLabel(n int) int {
	hits := 0
outer:
	for i := 0; i < n; i++ {
		t := strings.TrimSpace("  eeeeeeeeeeeeeeeeeeee  ")
		if len(t) == 20 {
			hits = hits + 1
		}
		for j := 0; j < n; j++ {
			s := strings.TrimSpace("  ffffffffffffffffff  ")
			if len(s) == 18 {
				hits = hits + 1
				continue outer
			}
		}
	}
	return hits
}

// EXIT PATH 6 — a NESTED loop's fall-through, where the inner local must go at
// the inner iteration's end and the outer's only at the outer's.
func nested(n int) int {
	hits := 0
	for i := 0; i < n; i++ {
		outerStr := strings.TrimSpace("  gggggggggggggggggggg  ")
		for j := 0; j < n; j++ {
			innerStr := strings.TrimSpace("  hhhhhhhhhhhhhhhhhh  ")
			if len(innerStr) == 18 {
				hits = hits + 1
			}
		}
		if len(outerStr) == 20 {
			hits = hits + 1
		}
	}
	return hits
}

func main() {
	reqs := []string{"  alpha  ", "  beta  ", "  gamma  "}
	// Reads the BYTES of a value produced inside a loop and kept past it.
	fmt.Println(carried(reqs))

	n := 200
	fmt.Println(fallThrough(n))
	fmt.Println(withContinue(n))
	fmt.Println(withBreak(n))
	fmt.Println(withReturn(n))
	fmt.Println(withLabel(n))
	fmt.Println(nested(20))
}
