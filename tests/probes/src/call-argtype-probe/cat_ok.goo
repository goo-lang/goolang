package main
import "fmt"
type Counter struct { n int }
func (c Counter) addn(x int) int { return c.n + x }
func add(a int, b int) int { return a + b }
func greet(s string) string { return s }
func main() { var c Counter = Counter{n: 7}; fmt.Println(add(1, 2)); fmt.Println(greet("hi")); fmt.Println(c.addn(3)) }
