# GENERATED by tools/probe_source_drift.sh --extract -- do not edit.
#
# The sources the printf-category probe gates build inside their own Makefile
# recipes, extracted so Bazel can reach them. tools/gen_probe_targets.py turns
# each into a target in ../generated.bzl, and source-drift-probe gates every
# file here against a fresh run of its recipe.
exports_files(glob([
    "**/*.goo",
    "**/*.go",
]))

# targets_current regenerates generated.bzl inside the sandbox and diffs, so it
# needs these sources present. Without them the generator sees no printf gates
# and emits 63 targets against the committed set -- a green-looking gate
# reading a tree that is not the one under test.
filegroup(
    name = "all_sources",
    srcs = glob([
        "**/*.goo",
        "**/*.go",
    ]),
    visibility = ["//tests/probes:__pkg__"],
)
