package main

import "fmt"

func sum(n int) int {
	total := 0
	for i := 0; i < n; i++ {
		total = total + i*2 - 1
	}
	return total
}

func fib(n int) int {
	if n < 2 {
		return n
	}
	a := 0
	b := 1
	for i := 2; i <= n; i++ {
		c := a + b
		a = b
		b = c
	}
	return b
}

func main() {
	x := sum(100)
	y := fib(20)
	total := 0
	for i := 0; i < 50; i++ {
		total = total + x*i - y
	}
	fmt.Println(x, y, total)
}
