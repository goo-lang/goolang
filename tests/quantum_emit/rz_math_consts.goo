package main

import "fmt"
import "qir"
import "math"

func main() {
	q := qir.Alloc()
	qir.Rz(math.Pi, q)
	qir.Rx(math.E, q)
	qir.Ry(math.Sqrt2, q)
	qir.Rz(math.Phi, q)
	qir.Rx(math.Ln2, q)
	qir.Rz(-math.Pi/2, q)
	r := qir.ResultAt(0)
	qir.Mz(q, r)
	fmt.Println(qir.ReadResult(r))
	qir.Reset(q)
	qir.FreeZero(q)
}
