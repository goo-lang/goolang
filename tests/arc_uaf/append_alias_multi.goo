// PR #376 review: the local that is self-appended reads RELEASE_OK although
// another value still names its array, because condition 7 runs only for a
// local with more than one binding and a self-append is not a binding. A
// release of the replaced array at the append frees memory that the alias
// reads. Expected output is from `go run` of the same program.
package main

import "fmt"

func multi() {
	xs := []int{}
	xs = append(xs, 5)
	ys := []int{}
	xs, ys = append(xs, 6), xs
	fmt.Println(ys[0], len(xs))
}

func main() {
	multi()
}
