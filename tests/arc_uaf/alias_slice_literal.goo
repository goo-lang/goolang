package main

import "fmt"

type Box struct{ v int }

// No parameter: a parameter's taint sets return_escapes, which makes the
// result unowned and hides the alias this fixture exists to test.
func mk1() *Box { return &Box{v: 1} }
func mk2() *Box { return &Box{v: 2} }

func yes(c bool) int {
	if c {
		return 1
	}
	return 0
}

// xs holds the first box through a slice literal. The store to x must not
// release that box, because xs[0] still reads it.
func s3() int {
	x := mk1()
	xs := []*Box{x}
	x = mk2()
	return yes(xs[0].v > 0) + yes(x.v > 0)
}

func main() {
	fmt.Println(s3(), s3())
}
