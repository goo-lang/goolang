package main

import "fmt"

type Box struct{ v int }
type B struct{}
type Reg struct{ items []*Box }

// A package-level func variable that shares its name with a method. A bare
// call `get()` calls the variable, never the method, so the method's summary
// says nothing about the result.
var get func() *Box

func (b *B) get() *Box {
	return &Box{v: 1}
}

func use() int {
	b := get()
	if b.v == 9 {
		return 1
	}
	return 0
}

func main() {
	r := &Reg{}
	r.items = append(r.items, &Box{v: 9})
	get = func() *Box { return r.items[0] }
	use()
	n := use()
	fmt.Println(n, r.items[0].v)
}
