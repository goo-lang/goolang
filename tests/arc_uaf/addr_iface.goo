package main

import "fmt"

type Getter interface {
	Get() int
}

type T struct {
	v int
}

func (t *T) Get() int { return t.v }

func mk() Getter {
	t := T{v: 45}
	return &t
}

func fill() int {
	var a [64]int
	s := 0
	for i := 0; i < 64; i++ {
		a[i] = 0x5555
		s += a[i]
	}
	return s
}

func main() {
	g := mk()
	fill()
	fmt.Println(g.Get())
}
