package main

import "fmt"

func build() []*int {
	r := []*int{}
	for i := 0; i < 2; i++ {
		v := i + 40
		r = append(r, &v)
	}
	return r
}

func fill() int {
	var a [64]int
	s := 0
	for i := 0; i < 64; i++ {
		a[i] = 0x5555
		s += a[i]
	}
	return s
}

func main() {
	r := build()
	fill()
	fmt.Println(*r[0], *r[1])
}
