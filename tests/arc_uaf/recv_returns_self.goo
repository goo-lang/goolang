package main

import "fmt"

type T struct {
	v int
}

func (t *T) self() *T { return t }

func mk() *T {
	t := T{v: 47}
	return t.self()
}

func fill() int {
	var a [64]int
	s := 0
	for i := 0; i < 64; i++ {
		a[i] = 0x5555
		s += a[i]
	}
	return s
}

func main() {
	p := mk()
	fill()
	fmt.Println(p.v)
}
